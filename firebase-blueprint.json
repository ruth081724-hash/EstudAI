{
  "entities": {
    "Conversation": {
      "title": "Conversation",
      "description": "AI study chat session metadata owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Conversation title (1-120 chars)."
        },
        "modelId": {
          "type": "string",
          "enum": ["gemini-3.8-flash", "gemini-3.5-flash-lite"],
          "description": "Selected free-tier Gemini model ID."
        },
        "studyMode": {
          "type": "string",
          "enum": ["TUTOR", "SOCRATIC", "CORNELL", "WRITING"],
          "description": "Pedagogical persona mode."
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Preview of the latest message (0-300 chars)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "modelId", "studyMode", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Single message inside a user's AI study conversation.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Denormalized authenticated Firebase UID of the owner."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "description": "Message author role."
        },
        "text": {
          "type": "string",
          "description": "Message text content (1-20000 chars)."
        },
        "modelUsed": {
          "type": "string",
          "description": "Model ID used to generate this message (0-64 chars)."
        },
        "hasImage": {
          "type": "boolean",
          "description": "Whether the user message included a homework photo attachment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "role", "text", "modelUsed", "hasImage", "createdAt"]
    },
    "HomeworkTask": {
      "title": "HomeworkTask",
      "description": "Homework assignment with due date, priority, and scheduled reminder.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Assignment title (1-150 chars)."
        },
        "subject": {
          "type": "string",
          "description": "Academic subject name (1-60 chars)."
        },
        "notes": {
          "type": "string",
          "description": "Optional assignment notes (0-1000 chars)."
        },
        "priority": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Assignment priority level."
        },
        "dueAtMillis": {
          "type": "integer",
          "description": "Due timestamp in epoch milliseconds (> 0)."
        },
        "reminderEnabled": {
          "type": "boolean",
          "description": "Whether local reminder notification is enabled."
        },
        "reminderAtMillis": {
          "type": "integer",
          "description": "Scheduled reminder timestamp in epoch milliseconds (>= 0)."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the homework task is completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "subject", "notes", "priority", "dueAtMillis", "reminderEnabled", "reminderAtMillis", "completed", "createdAt", "updatedAt"]
    },
    "FlashcardDeck": {
      "title": "FlashcardDeck",
      "description": "Active recall flashcard deck generated by AI or created for study.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Deck title (1-120 chars)."
        },
        "subject": {
          "type": "string",
          "description": "Subject category (1-60 chars)."
        },
        "cards": {
          "type": "array",
          "description": "Bounded list of 1-30 flashcard maps with front/back/hint/mastery."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "subject", "cards", "createdAt", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Logged study methodology session (Pomodoro, Feynman, Cornell, Flashcards, Quiz).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the owner."
        },
        "technique": {
          "type": "string",
          "enum": ["POMODORO", "FEYNMAN", "CORNELL", "FLASHCARDS", "QUIZ"],
          "description": "Study methodology used."
        },
        "topic": {
          "type": "string",
          "description": "Study topic or subject (1-150 chars)."
        },
        "durationMinutes": {
          "type": "integer",
          "description": "Session duration in minutes (0-240)."
        },
        "scoreOrRating": {
          "type": "integer",
          "description": "Mastery score or rating percentage (0-100)."
        },
        "summary": {
          "type": "string",
          "description": "Key takeaways or AI feedback summary (0-2000 chars)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "technique", "topic", "durationMinutes", "scoreOrRating", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "User's AI study chat conversations."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a user's AI study chat conversation."
    },
    "/users/{userId}/homeworkTasks/{taskId}": {
      "schema": { "$ref": "#/entities/HomeworkTask" },
      "description": "User's homework assignments and reminder schedules."
    },
    "/users/{userId}/flashcardDecks/{deckId}": {
      "schema": { "$ref": "#/entities/FlashcardDeck" },
      "description": "User's active-recall flashcard decks."
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "User's completed study methodology logs."
    }
  }
}
